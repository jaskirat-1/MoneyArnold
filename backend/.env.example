# Azure AI Foundry Configuration
# The endpoint shown in your Microsoft Foundry Code section:
AZURE_AI_PROJECT_ENDPOINT=https://MoneyArnold-01.services.ai.azure.com/api/projects/MoneyArnold-01

# Option A: If your workflow itself is exposed as an Agent in Foundry, put its Agent ID here:
FOUNDRY_WORKFLOW_ID=

# Option B: If calling the 3 agents sequentially, put their Agent IDs here (found in Foundry > Agents):
AGENT_ANALYZER_ID=
AGENT_PLANNER_ID=
AGENT_ACTION_ID=

# Local Testing Fallback:
# Set to 'false' when az login is authenticated and you want direct Foundry calls.
# Set to 'true' to safely test UI & FastAPI offline using the exact verified test outputs.
USE_MOCK_FALLBACK=false
